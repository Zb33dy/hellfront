{
  "name": "hellfront",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "app": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "@babylonjs/core": "^9.31.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0"
  },
  "allowScripts": {
    "electron@44.9.0": true
  },
  "description": "HELLFRONT — a retro first-person shooter",
  "author": "Hunk de Poitiers",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.hunkdepoitiers.hellfront",
    "productName": "HELLFRONT",
    "copyright": "Copyright (c) 2026 Hunk de Poitiers",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "icon": "electron/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HELLFRONT",
      "artifactName": "HELLFRONT-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "HELLFRONT-Portable-${version}.${ext}"
    },
    "electronDist": "node_modules/electron/dist"
  }
}
